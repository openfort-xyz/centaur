{
  "name": "googlechatbot",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --hot --watch src/server.ts",
    "start": "bun src/server.ts",
    "smoke": "bun scripts/smoke.ts",
    "test": "for file in $(find src -name '*.test.ts' | sort); do bun test \"$file\" || exit 1; done",
    "check:types": "bun tsgo --project tsconfig.json --noEmit"
  },
  "dependencies": {
    "@centaur/harness-events": "workspace:*",
    "@centaur/rendering": "workspace:*",
    "@chat-adapter/state-pg": "^4.31.0",
    "chat": "^4.31.0",
    "hono": "^4.12.18",
    "pg": "^8.21.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@chat-adapter/state-memory": "^4.31.0",
    "@types/bun": "^1.3.13",
    "@types/node": "^25.7.0",
    "@types/pg": "^8.15.5",
    "@typescript/native-preview": "^7.0.0-dev.20260512.1",
    "typescript": "^6.0.3"
  }
}
