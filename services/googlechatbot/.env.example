PORT=3002
NODE_ENV="development"
COMMIT_SHA="local"

# Google service account key (raw JSON). Grants the bot the chat.bot scope to
# post/edit messages and chat.app.messages.readonly to read thread history.
GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...","private_key":"...","client_email":"...@...iam.gserviceaccount.com"}

# api-rs (Rust Centaur API) the bot drives sessions against.
CENTAUR_API_URL="http://127.0.0.1:8080"
# Bearer token for api-rs (preferred); CENTAUR_API_KEY is the fallback.
GOOGLECHATBOT_API_KEY=""
CENTAUR_API_KEY=""

CHAT_EVENTS_PATH="/api/chat/events"
CHAT_EVENT_DEDUP_TTL_MS="600000"
CHAT_EVENT_MAX_AGE_SECONDS="300"

# Authenticate inbound requests with exactly one official Google contract:
# - chat_api_project: Chat API service-account token, audience = project number
# - chat_api_url: Chat API OIDC token, audience = exact webhook URL
# - workspace_addon: Add-ons OIDC token, audience = exact webhook URL
GOOGLECHATBOT_REQUIRE_SIGNED_REQUESTS="true"
GOOGLECHATBOT_INGRESS_MODE="chat_api_project"
GOOGLECHATBOT_PROJECT_NUMBER=""
GOOGLECHATBOT_WEBHOOK_AUDIENCE=""
GOOGLECHATBOT_ADDON_SERVICE_ACCOUNT_EMAIL=""
GOOGLECHATBOT_ADDON_OAUTH_CLIENT_ID=""
GOOGLECHATBOT_SIGNED_REQUEST_MAX_AGE_SECONDS="300"

# Verified-human email-domain allowlist. Only Workspace Add-on userIdToken
# identity can satisfy it; Chat API User bodies contain no email. Empty accepts
# all authenticated requests but emits no human email identity.
GOOGLECHATBOT_ALLOWED_DOMAIN=""

# Workspace user the service account impersonates for attachment uploads
# (media.upload rejects app auth). Requires a domain-wide-delegation grant of
# chat.messages.create to the SA's client ID. Empty = uploads fail closed.
GOOGLECHATBOT_UPLOAD_USER=""
# Workspace user impersonated for reactions.list. Requires
# chat.messages.reactions.readonly.
GOOGLECHATBOT_REACTION_READ_USER=""
# Optional, independently revocable Drive download delegation. Requires only
# drive.readonly; absent grants preserve attachment metadata without bytes.
GOOGLECHATBOT_DRIVE_DOWNLOAD_USER=""
# Private api-rs-to-googlechatbot credential; never expose it to a sandbox.
GOOGLECHATBOT_INTERNAL_API_KEY=""
GOOGLECHATBOT_THREAD_HISTORY_LIMIT="50"
GOOGLECHATBOT_ATTACHMENT_AGGREGATE_MAX_BYTES="104857600"

# Optional per-run guards forwarded to api-rs.
SESSION_IDLE_TIMEOUT_MS=""
SESSION_MAX_DURATION_MS=""

# Response footer controls, matching Slackbot v2.
GOOGLECHATBOT_RESPONSE_METADATA_MODE="first"
GOOGLECHATBOT_RESPONSE_SERVICE_TIER_ENABLED="false"
