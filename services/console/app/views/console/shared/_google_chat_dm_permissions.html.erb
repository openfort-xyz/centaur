<% owner = local_assigns.fetch(:owner) %>
<% url = local_assigns.fetch(:url) %>
<% inherited_permissions = local_assigns.fetch(:inherited_permissions, []) %>
<% permissions = @google_chat_dm_permissions || [] %>
<% checkbox_class = "h-4 w-4 rounded border-ink-500 bg-ink-800 text-centaur-500 focus:ring-centaur-500" %>

<section class="mb-8">
  <div class="mb-4">
    <h2 class="mb-1 text-xs font-semibold uppercase tracking-wider text-zinc-500">Google Chat DM Permissions</h2>
  </div>
  <div class="console-panel">
    <%= form_with model: owner, url: url, method: :patch, data: { turbo: false } do |form| %>
      <% if permissions.any? %>
        <div class="overflow-x-auto">
          <table class="console-table min-w-full">
            <thead class="console-table-head">
              <tr><th class="console-th">Target email</th><th class="console-th">Setup</th><th class="console-th">Remove</th></tr>
            </thead>
            <tbody class="divide-y divide-ink-700">
              <% permissions.each do |permission| %>
                <%= form.fields_for :google_chat_dm_permissions, permission do |permission_fields| %>
                  <tr>
                    <td class="console-td break-all">
                      <%= permission_fields.hidden_field :id %>
                      <%= permission.target_identity %>
                    </td>
                    <td class="console-td">
                      <%= permission_fields.check_box :setup_enabled,
                                                      class: checkbox_class,
                                                      aria: { label: "DM setup for #{permission.target_identity}" } %>
                    </td>
                    <td class="console-td">
                      <%= button_tag type: "submit",
                                     name: nil,
                                     form: "delete_google_chat_dm_permission_#{permission.oid}",
                                     class: "grid size-8 place-items-center rounded text-zinc-500 hover:bg-red-500/10 hover:text-red-300 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-red-400",
                                     aria: { label: "Delete #{permission.target_identity}" },
                                     title: "Delete #{permission.target_identity}" do %>
                        <%= console_icon("trash", classes: "size-4") %>
                      <% end %>
                    </td>
                  </tr>
                <% end %>
              <% end %>
            </tbody>
          </table>
        </div>
      <% else %>
        <div class="p-4"><div class="empty-state">No Google Chat DM targets selected.</div></div>
      <% end %>

      <% new_permission = GoogleChatDmPermission.new(setup_enabled: true) %>
      <%= form.fields_for :google_chat_dm_permissions, new_permission do |permission_fields| %>
        <div class="grid gap-4 border-t border-ink-700 p-5 sm:grid-cols-[minmax(0,1fr)_auto]">
          <label class="block">
            <span class="form-label">Add DM Target</span>
            <%= permission_fields.text_field :target_identity,
                                             class: "form-input",
                                             placeholder: "person@example.com",
                                             autocomplete: "off" %>
          </label>
          <label class="flex items-center gap-2 sm:pt-7">
            <%= permission_fields.check_box :setup_enabled, class: checkbox_class %>
            <span class="text-sm font-medium text-zinc-100">Setup</span>
          </label>
        </div>
      <% end %>

      <div class="px-5 pb-5"><%= submit_tag "Save Google Chat DM permissions", class: "btn-primary" %></div>
    <% end %>

    <% permissions.each do |permission| %>
      <%= form_with url: console_google_chat_dm_permission_path(permission),
                    method: :delete,
                    id: "delete_google_chat_dm_permission_#{permission.oid}",
                    data: { turbo: false },
                    class: "hidden" do %>
      <% end %>
    <% end %>
  </div>

  <% if inherited_permissions.present? %>
    <div class="mb-3 mt-6"><h3 class="text-xs font-semibold uppercase tracking-wider text-zinc-500">Inherited From Roles</h3></div>
    <div class="console-panel overflow-x-auto">
      <table class="console-table min-w-full">
        <thead class="console-table-head"><tr><th class="console-th">Target email</th><th class="console-th">Setup</th></tr></thead>
        <tbody class="divide-y divide-ink-700">
          <% inherited_permissions.each do |permission| %>
            <tr>
              <td class="console-td break-all"><%= permission.fetch("target_identity") %></td>
              <td class="console-td">
                <%= check_box_tag nil, "1", permission.fetch("setup_enabled"), disabled: true,
                                  class: checkbox_class,
                                  aria: { label: "Inherited DM setup for #{permission.fetch("target_identity")}" } %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% end %>
</section>
